flowchart TD
 A(["GET /api/bookings/{id}"]) --> C["Controller gọi Service.GetDetailAsync(id)"]
 C --> S["Service gọi Repository.GetDetailAsync(id)"]
 S --> R1["GetByIdAsync: join booking và thông tin suất chiếu"]
 R1 --> DB1[("SQL Server<br/>Bookings, Users, ShowTimes, Movies,<br/>Halls, Cinemas, Tickets, Payments")]
 DB1 --> D{"Booking tồn tại?"}
 D -- Không --> N(["404 Booking not found"])
 D -- Có --> R2["Đọc Tickets + Seats + SeatTypes"]
 R2 --> R3["Đọc BookingConcessions + ConcessionItems"]
 R3 --> R4["Đọc Payments"]
 R4 --> DB2[("SQL Server<br/>Tickets, Seats, SeatTypes,<br/>BookingConcessions, ConcessionItems, Payments")]
 DB2 --> O(["200 OK<br/>BookingDetailResponse"])
