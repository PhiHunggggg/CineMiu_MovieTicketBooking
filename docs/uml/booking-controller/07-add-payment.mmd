flowchart TD
 A(["POST /api/bookings/{id}/payments"]) --> C["Controller gọi Service.AddPaymentAsync"]
 C --> S["Service gọi Repository.AddPaymentAsync"]
 S --> R1["Đọc Booking; kiểm tra status"] --> R2["Kiểm tra PaymentMethod active<br/>và TransactionRef chưa tồn tại"]
 R2 --> R3["Tính tổng đã thanh toán<br/>và outstanding amount"]
 R3 --> DB1[("SQL Server<br/>Bookings, PaymentMethods, Payments")]
 DB1 --> D{"Hợp lệ?"}
 D -- Không, not found --> N(["404 Not Found"])
 D -- Không, lỗi khác --> B(["400 Bad Request"])
 D -- Có --> R4["Tạo Payment paid"]
 R4 --> D2{"Đã trả đủ và chưa confirmed?"}
 D2 -- Có --> R5["Booking.Status = confirmed<br/>set ConfirmedAt, clear ExpiresAt"]
 D2 -- Không --> DB2
 R5 --> DB2[("SQL Server<br/>Payments, Bookings")]
 DB2 --> D3{"NewlyConfirmed?"}
 D3 -- Có --> L["LoyaltyService.AddPointsAsync"] --> LDB[("SQL Server<br/>Loyalty data")]
 D3 -- Không --> O
 LDB --> O(["200 OK<br/>PaymentResponse"])
